# file opened: engine.asm
   1+ 8000              ; =============================================================================
   2+ 8000              ; engine.asm - motor LABIRINTO: aventura de ação vista de cima, com troca de
   3+ 8000              ; tela por salas (flip-screen), para TK90X/TK95 (ZX Spectrum 48K).
   4+ 8000              ;
   5+ 8000              ; Licença MIT - (c) 2026 Projeto Emulador TK90X
   6+ 8000              ;
   7+ 8000              ; O motor não sabe nada do jogo: mapa, gráficos, textos e tabelas vêm do
   8+ 8000              ;  arquivo do jogo (ver selva.asm e LEIAME.md, seção "Motor"). Rótulos e
   9+ 8000              ; constantes que o jogo precisa fornecer:
  10+ 8000              ;   dados do mapa (mapa_lib.py): rooms room_names floor_names templates
  11+ 8000              ;     links_lock items_def NUM_ROOMS NUM_LINKS NUM_ITEMS START_ROOM START_X START_Y
  12+ 8000              ;   gráficos (gfx2asm.py): spr16_src spr8_src NUM_SPR16 NUM_SPR8
  13+ 8000              ;   ladrilhos: GFX_WALLS (4 estilos seguidos) GFX_DOOR GFX_MASTER GFX_UP
  14+ 8000              ;     GFX_DOWN GFX_DECO1 GFX_DECO2; door_attr (4 bytes) MASTER_ATTR
  15+ 8000              ;   jogador/projétil/poeira: PLAYER_SPR PLAYER_INK PROJ_SPR8 PROJ_INK
  16+ 8000              ;     POOF_SPR POOF_INK PROJ_RANGE
  17+ 8000              ;   tabelas: enemy_types (8 bytes cada) NUM_ETYPES; item_kinds (8 bytes cada)
  18+ 8000              ;   painel: hud_labels HUD_ATTR HUD_NAME_ATTR HUD_FLOOR_ATTR BAR_ATTR_OK
  19+ 8000              ;     BAR_ATTR_LOW ICON_KEY ICON_PIECE ICON_EMPTY PIECE_ATTR EMPTY_ATTR
  20+ 8000              ;     key_icon_attr (4 bytes) PIECES_NEEDED
  21+ 8000              ;   regras: ENERGY_MAX (<=128) DRAIN_TICKS LIVES RESPAWN_TICKS WIN_BONUS (BCD)
  22+ 8000              ;   telas: TITLE_ATTR game_title game_page1 game_page2 game_page2_hook
  23+ 8000              ;     txt_mode0 txt_mode1 TITLE_PAGE_ROW TITLE_PAGE_ROWS TITLE_PAGE_FRAMES
  24+ 8000              ;     txt_victory txt_gameover END_SCORE_ROW END_SCORE_COL
  25+ 8000              ;
  26+ 8000              ; Opções (DEFINE antes do include; versão 2 do motor, feita para a selva):
  27+ 8000              ;   HEDGE_EDGES   bordas orgânicas: as células de parede (T_WALL) que encostam
  28+ 8000              ;                 em algo que não é parede ganham uma franja recortada (sebes)
  29+ 8000              ;   PROJ_DIRECTIONAL  o projétil usa 4 desenhos 8x8 (cima, baixo, esq., dir.)
  30+ 8000              ;                 a partir de PROJ_SPR8, em vez de 2 quadros animados
  31+ 8000              ;   BEH_STATIC    comportamento 3: monstro parado (planta), só anima
  32+ 8000              ;   RANDOM_SPAWN  monstros surgem em pontos aleatórios livres da sala
  33+ 8000              ;   FLOWERS       objetos de efeito 3 (flores) dão efeitos temporários:
  34+ 8000              ;                 1 velocidade, 2 invulnerável (a cor cintila: tinta XOR 2),
  35+ 8000              ;                 3 confusão (direções trocadas).
  36+ 8000              ;                 As flores renascem quando o jogador volta à sala. O jogo
  37+ 8000              ;                 fornece effect_ink e effect_ticks (4 bytes cada, índice 0
  38+ 8000              ;                 sem uso), ICON_FLOWER, EFFECT_ROW e EFFECT_COL
  39+ 8000              ;   SHADOW_ATTRS  as cores dos objetos são montadas numa sombra (SHADOW) e só
  40+ 8000              ;                 depois copiadas para a tela: nenhuma célula passa pela cor
  41+ 8000              ;                 do chão no meio do quadro (sem piscar cinza)
  42+ 8000              ;   GAME_TUNE     o jogo fornece victory_tune (pares meio-período, duração; 0,0)
  43+ 8000              ;   GAME_SHOOT_SND  o jogo fornece snd_shoot
  44+ 8000              ; =============================================================================
  45+ 8000
  46+ 8000              ; ---------------- endereços fixos ----------------
  47+ 8000              FRAMES      EQU 23672           ; contador de quadros da ROM (byte baixo)
  48+ 8000              SCREEN      EQU 0x4000
  49+ 8000              ATTRS       EQU 0x5800
  50+ 8000              SHBUF16     EQU 0xC000          ; sprites 16x16 pré-deslocados (192 bytes cada)
  51+ 8000              SHBUF8      EQU 0xD400          ; sprites 8x8 pré-deslocados (64 bytes cada)
  52+ 8000              CMAP        EQU 0xD800          ; mapa de células da sala (32x20)
  53+ 8000              BGATTR      EQU 0xDB00          ; atributos de fundo da sala (32x20)
  54+ 8000              ROWTAB      EQU 0xDE00          ; endereço de tela de cada linha de pixel (192 x 2)
  55+ 8000              GLYPHBUF    EQU 0xDF80          ; 8 bytes: caractere sendo montado
  56+ 8000              ENBUF       EQU 0xDF90          ; 16 bytes: barra de energia
  57+ 8000              EDGEBUF     EQU 0xDFA0          ; 8 bytes: célula de sebe com franja
  58+ 8000              SHADOW      EQU 0xE000          ; sombra dos atributos da sala (32x20)
  59+ 8000
  60+ 8000              ; ---------------- ladrilhos (valores no CMAP) ----------------
  61+ 8000              T_FLOOR     EQU 0
  62+ 8000              T_WALL      EQU 1
  63+ 8000              T_DOOR      EQU 2               ; 2..5 = portas vermelha, verde, azul, amarela
  64+ 8000              T_MASTER    EQU 6               ; porta da Chave Mestra
  65+ 8000              T_UP        EQU 7
  66+ 8000              T_DOWN      EQU 8
  67+ 8000              T_DECO1     EQU 9
  68+ 8000              T_DECO2     EQU 10
  69+ 8000
  70+ 8000              ; ---------------- registro da sala (gerado por mapa_lib.py) ----------------
  71+ 8000              R_NAME      EQU 0
  72+ 8000              R_FLOOR     EQU 1
  73+ 8000              R_WATTR     EQU 2
  74+ 8000              R_FATTR     EQU 3
  75+ 8000              R_DATTR     EQU 4
  76+ 8000              R_STYLE     EQU 5
  77+ 8000              R_TMPL      EQU 6
  78+ 8000              R_EXITS     EQU 7               ; N(dest,link) S(dest,link) O(dest,link) L(dest,link)
  79+ 8000              R_SDEST     EQU 15
  80+ 8000              R_SX        EQU 16
  81+ 8000              R_SY        EQU 17
  82+ 8000              R_STYPE     EQU 18
  83+ 8000              R_ETYPE     EQU 19
  84+ 8000              R_ECOUNT    EQU 20
  85+ 8000              ROOM_SIZE   EQU 21
  86+ 8000              EXIT_OUT    EQU 0xFE            ; destino = fora do mapa (vitória)
  87+ 8000              NO_EXIT     EQU 0xFF
  88+ 8000
  89+ 8000              ; ---------------- objetos na tela ----------------
  90+ 8000              O_VIS       EQU 0               ; estado desejado
  91+ 8000              O_X         EQU 1
  92+ 8000              O_Y         EQU 2
  93+ 8000              O_GFX       EQU 3               ; 2 bytes: quadro (deslocamento 0)
  94+ 8000              O_SIZE      EQU 5               ; 0 = 16x16, 1 = 8x8
  95+ 8000              O_INK       EQU 6
  96+ 8000              O_OVIS      EQU 7               ; o que está desenhado agora (XOR)
  97+ 8000              O_OX        EQU 8
  98+ 8000              O_OY        EQU 9
  99+ 8000              O_OGFX      EQU 10
 100+ 8000              O_OSIZE     EQU 12
 101+ 8000              O_AVIS      EQU 13              ; caixa de atributos pintada agora
 102+ 8000              O_AX        EQU 14
 103+ 8000              O_AY        EQU 15
 104+ 8000              O_ASIZE     EQU 16
 105+ 8000              O_STATE     EQU 17
 106+ 8000              O_TYPE      EQU 18
 107+ 8000              O_DX        EQU 19
 108+ 8000              O_DY        EQU 20
 109+ 8000              O_TIMER     EQU 21
 110+ 8000              O_HP        EQU 22
 111+ 8000              O_DTIM      EQU 23
