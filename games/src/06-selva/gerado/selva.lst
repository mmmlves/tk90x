 119+ 8000              ES_APPEAR   EQU 2
 120+ 8000              ES_ALIVE    EQU 3
 121+ 8000              ES_DYING    EQU 4
 122+ 8000
 123+ 8000              ; bits de entrada
 124+ 8000              IN_R        EQU 0
