   1  0000              ; =============================================================================
   2  0000              ; selva.asm - "A Selva de Verdemor"
   3  0000              ; Aventura de ação num labirinto de selva, vista de cima, para TK90X/TK95
   4  0000              ; (ZX Spectrum 48K). Jogo original: mapa, desenhos, criaturas, textos e sons
   5  0000              ; próprios.
   6  0000              ;
   7  0000              ; Licença MIT - (c) 2026 Projeto Emulador TK90X
   8  0000              ;
   9  0000              ; Montagem: ./build.sh  (gera gerado/selva.tap e copia para games/)
  10  0000              ; Este arquivo contém só o que é deste jogo; o motor fica em motor/engine.asm.
  11  0000              ; =============================================================================
  12  0000
  13  0000                      DEVICE ZXSPECTRUM48
  14  0000
  15  0000              ; opções do motor LABIRINTO usadas por este jogo
  16  0000                      DEFINE HEDGE_EDGES
  17  0000                      DEFINE PROJ_DIRECTIONAL
  18  0000                      DEFINE BEH_STATIC
  19  0000                      DEFINE RANDOM_SPAWN
  20  0000                      DEFINE FLOWERS
  21  0000                      DEFINE SHADOW_ATTRS
  22  0000                      DEFINE GAME_TUNE
  23  0000                      DEFINE GAME_SHOOT_SND
  24  0000
  25  0000              ORIGEM  EQU 32768
