  52+ 8000              R_WATTR     EQU 2
  53+ 8000              R_FATTR     EQU 3
  54+ 8000              R_DATTR     EQU 4
  55+ 8000              R_STYLE     EQU 5
  56+ 8000              R_TMPL      EQU 6
  57+ 8000              R_EXITS     EQU 7               ; N(dest,link) S(dest,link) O(dest,link) L(dest,link)
  58+ 8000              R_SDEST     EQU 15
  59+ 8000              R_SX        EQU 16
  60+ 8000              R_SY        EQU 17
  61+ 8000              R_STYPE     EQU 18
  62+ 8000              R_ETYPE     EQU 19
  63+ 8000              R_ECOUNT    EQU 20
  64+ 8000              ROOM_SIZE   EQU 21
  65+ 8000              EXIT_OUT    EQU 0xFE            ; destino = fora do castelo (vitória)
  66+ 8000              NO_EXIT     EQU 0xFF
  67+ 8000
  68+ 8000              ; ---------------- objetos na tela ----------------
  69+ 8000              O_VIS       EQU 0               ; estado desejado
  70+ 8000              O_X         EQU 1
  71+ 8000              O_Y         EQU 2
  72+ 8000              O_GFX       EQU 3               ; 2 bytes: quadro (deslocamento 0)
  73+ 8000              O_SIZE      EQU 5               ; 0 = 16x16, 1 = 8x8
  74+ 8000              O_INK       EQU 6
  75+ 8000              O_OVIS      EQU 7               ; o que está desenhado agora (XOR)
  76+ 8000              O_OX        EQU 8
  77+ 8000              O_OY        EQU 9
  78+ 8000              O_OGFX      EQU 10
  79+ 8000              O_OSIZE     EQU 12
  80+ 8000              O_AVIS      EQU 13              ; caixa de atributos pintada agora
  81+ 8000              O_AX        EQU 14
  82+ 8000              O_AY        EQU 15
  83+ 8000              O_ASIZE     EQU 16
  84+ 8000              O_STATE     EQU 17
  85+ 8000              O_TYPE      EQU 18
