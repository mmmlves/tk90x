<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9+: a janela ja nasce ocupando o recorte da camera (notch/furo) nas bordas
         curtas, que em paisagem sao os lados. Assim o primeiro layout ja tem o tamanho
         final e a superficie do SDL nao muda de tamanho logo depois de criada (o que
         congelava a imagem; veja docs/ANDROID.md). O TK90XActivity tambem define isto
         antes do super.onCreate. -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
